{
  "name": "ha.mr",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "build": "npm run generate:dictionaries && tsc && node copy-static.mjs && esbuild dist/main.js dist/compress.js dist/alphabets.js dist/compression-dictionaries.js --minify --charset=utf8 --allow-overwrite --outdir=dist --format=esm && esbuild lean-qr --bundle --minify --format=iife --global-name=LeanQr --outfile=dist/lean-qr.js",
    "build:cli:bundle": "esbuild src/quickjs.ts --bundle --minify --platform=neutral --main-fields=module,main --format=esm --external:qjs:std --outfile=dist/hamr.quickjs.js",
    "build:cli:local": "npm run build:cli:bundle && node build-cli.mjs",
    "check": "tsc --noEmit",
    "dev:quickjs": "npm run build:cli:bundle && qjs dist/hamr.quickjs.js",
    "generate:dictionaries": "node generate-dictionaries.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "lean-qr": "^2.7.3",
    "whatwg-url": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/whatwg-url": "^13.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
